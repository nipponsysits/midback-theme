{
  "name": "midback-design-system",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "author": "Mr.Kananek Thongkam",
  "license": "ISC",
  "description": "Travox MidBack design system rebuilt with Astro, Svelte, and Tailwind CSS 4.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:dist": "bun run scripts/verify-dist.ts",
    "validate": "bun run check && bun run test && bun run build && bun run verify:dist"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.3",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.56.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}
