---
import '../styles/global.css';

type Props = {
  title: string;
  description?: string;
};

const {
  title,
  description = 'The Travox MidBack interface, rebuilt as a lightweight Astro and Svelte design system.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#78bb34" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={Astro.url} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
